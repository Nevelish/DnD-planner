generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js required models ----------

enum UserRole {
  ADMIN
  USER
}

enum TimeFormat {
  HOUR_12
  HOUR_24
}

/// Day-before-month (DMY, Norwegian/European) vs month-before-day (MDY, US)
/// ordering for displaying dates. Governs the calendar's week-start day too
/// (Monday for DMY, Sunday for MDY).
enum DateFormat {
  DMY
  MDY
}

model User {
  id                     String             @id @default(cuid())
  name                   String?
  email                  String?            @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String? // null for Discord-only accounts
  calendarToken          String?            @unique // secret token for the .ics subscription feed
  role                   UserRole           @default(USER)
  disabled               Boolean            @default(false) // blocks sign-in without deleting their campaigns/notes/RSVPs
  timeFormat             TimeFormat         @default(HOUR_24)
  dateFormat             DateFormat         @default(DMY)
  discordUserId          String? // opts this account into @mentions on session proposed/cancelled Discord posts;
  // auto-filled on first Discord sign-in, editable in Account settings
  // Opt-outs rather than opt-ins, so event types added later are on by
  // default. Set in Account settings → Notifications.
  mutedNotificationTypes NotificationType[] @default([]) // no in-app notification for these
  mutedMentionTypes      NotificationType[] @default([]) // no Discord @mention for these
  avatarUpdatedAt        DateTime? // set while an uploaded picture exists; doubles as its cache-busting version
  sessionVersion         Int                @default(0) // bumped on a password change/reset: sign-ins from before stop working

  accounts Account[]
  sessions Session[]

  memberships       CampaignMember[]
  proposedSessions  SessionProposal[] @relation("ProposedBy")
  notifications     Notification[]
  campaignNotes     CampaignNote[]
  playerNotes       PlayerNote[]
  ownedCampaigns    Campaign[]        @relation("CampaignOwner")
  createdPolls      DatePoll[]        @relation("PollCreatedBy")
  addedPollDates    DatePollOption[]  @relation("PollOptionAddedBy")
  recapsEdited      SessionProposal[] @relation("RecapAuthor")
  avatar            UserAvatar?
  awayPeriods       AwayPeriod[]
  notebookImages    NotebookImage[]   @relation("NotebookImages")
  uploadedImages    NotebookImage[]   @relation("NotebookImagesUploaded")
  notebookPages     NotebookPage[]    @relation("NotebookPages")
  notebookPagesMade NotebookPage[]    @relation("NotebookPagesCreated")
  safetyEntries     SafetyEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Single-row table of server-wide settings, managed from /admin/settings.
/// Always read/written at the fixed id "default" — there is only ever one row.
model AppSettings {
  id        String   @id @default("default")
  publicUrl String? // overrides NEXTAUTH_URL for building absolute links (invites, calendar feed)
  updatedAt DateTime @updatedAt
}

// ---------- Core domain ----------

enum CampaignRole {
  DM
  PLAYER
}

model Campaign {
  id                   String             @id @default(cuid())
  name                 String
  description          String?            @db.Text
  ownerId              String
  inviteCode           String             @unique
  discordWebhookUrl    String? // posts campaign notifications (session proposed/cancelled, RSVP, etc.) to Discord
  sessionZero          Json? // the DM's Session Zero answers: { [questionKey]: answer }, see src/lib/sessionZero.ts
  discordWebhookEvents NotificationType[] @default([SESSION_PROPOSED, SESSION_RESCHEDULED, SESSION_CONFIRMED, SESSION_CANCELLED, SESSION_REMINDER, DATE_POLL_OPENED, RECAP_POSTED, RSVP_CHANGED, MEMBER_JOINED, MEMBER_LEFT, RECURRING_DRAFT_READY, PAGE_REVEALED]) // which event types actually post to discordWebhookUrl
  discordChannelId     String? // channel the Discord bot posts to, with RSVP buttons (set with /planner connect); takes over from the webhook
  discordAutoJoin      Boolean            @default(false) // an RSVP button click from someone without an account creates one and adds them as a player
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  owner            User              @relation("CampaignOwner", fields: [ownerId], references: [id])
  members          CampaignMember[]
  sessionProposals SessionProposal[]
  recurringRules   RecurringRule[]
  characters       Character[]
  notes            CampaignNote[]
  playerNotes      PlayerNote[]
  notifications    Notification[]
  datePolls        DatePoll[]
  safetyEntries    SafetyEntry[]
  notebookPages    NotebookPage[]
  notebookImages   NotebookImage[]
}

model CampaignMember {
  id         String       @id @default(cuid())
  campaignId String
  userId     String
  role       CampaignRole
  joinedAt   DateTime     @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  rsvps      Rsvp[]
  characters Character[]
  pollVotes  DatePollVote[]

  @@unique([campaignId, userId])
}

enum SessionProposalStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model SessionProposal {
  id              String                @id @default(cuid())
  campaignId      String
  proposedById    String
  title           String?
  startsAt        DateTime
  durationMinutes Int?
  format          SessionFormat? // in person or online; null = not said
  location        String? // an address/place, or a link/platform for online games
  description     String?               @db.Text
  recap           String?               @db.Text // "what happened", written by anyone in the campaign once it's COMPLETED
  recapUpdatedAt  DateTime? // doubles as the optimistic-concurrency version for recap edits
  recapAuthorId   String? // whoever last edited the recap
  status          SessionProposalStatus @default(PROPOSED)
  recurringRuleId String?
  cancelReason    String?               @db.Text
  reminderSentAt  DateTime? // set once the 24h-before reminder has gone out; cleared on reschedule
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  campaign        Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  proposedBy      User                    @relation("ProposedBy", fields: [proposedById], references: [id])
  recapAuthor     User?                   @relation("RecapAuthor", fields: [recapAuthorId], references: [id], onDelete: SetNull)
  recurringRule   RecurringRule?          @relation(fields: [recurringRuleId], references: [id])
  rsvps           Rsvp[]
  datePoll        DatePoll?
  prepPage        NotebookPage?
  discordMessages DiscordSessionMessage[]

  @@index([campaignId, startsAt])
}

enum SessionFormat {
  IN_PERSON
  ONLINE
}

enum RsvpStatus {
  PENDING
  YES
  MAYBE
  NO
}

model Rsvp {
  id                 String     @id @default(cuid())
  sessionProposalId  String
  memberId           String
  status             RsvpStatus @default(PENDING)
  cancellationReason String?    @db.Text
  respondedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessionProposal SessionProposal @relation(fields: [sessionProposalId], references: [id], onDelete: Cascade)
  member          CampaignMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionProposalId, memberId])
}

enum DatePollStatus {
  OPEN
  DECIDED
  CANCELLED
}

/// "Which date works?" — the DM offers several candidate start times and
/// players mark each Yes/Maybe/No. Picking a winner creates an ordinary
/// SessionProposal (linked via sessionProposalId) with RSVPs pre-filled
/// from the votes.
model DatePoll {
  id                String         @id @default(cuid())
  campaignId        String
  createdById       String
  title             String?
  durationMinutes   Int
  status            DatePollStatus @default(OPEN)
  sessionProposalId String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  campaign        Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("PollCreatedBy", fields: [createdById], references: [id])
  sessionProposal SessionProposal?     @relation(fields: [sessionProposalId], references: [id], onDelete: SetNull)
  options         DatePollOption[]
  discordMessages DiscordPollMessage[]

  @@index([campaignId, status])
}

model DatePollOption {
  id        String   @id @default(cuid())
  pollId    String
  startsAt  DateTime
  addedById String? // set when someone added this date after the poll opened; null for the DM's original dates

  poll    DatePoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  addedBy User?          @relation("PollOptionAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  votes   DatePollVote[]

  @@unique([pollId, startsAt])
}

/// One player's answer for one candidate date. Reuses RsvpStatus for the
/// same Yes/Maybe/No vocabulary; PENDING is never stored — no row means no
/// answer yet.
model DatePollVote {
  id        String     @id @default(cuid())
  optionId  String
  memberId  String
  choice    RsvpStatus
  updatedAt DateTime   @updatedAt

  option DatePollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  member CampaignMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([optionId, memberId])
}

enum RecurrenceFrequency {
  WEEKLY
  CUSTOM_INTERVAL
}

model RecurringRule {
  id               String              @id @default(cuid())
  campaignId       String
  frequency        RecurrenceFrequency
  intervalWeeks    Int                 @default(1)
  dayOfWeek        Int
  timeOfDayMinutes Int
  timezone         String
  anchorDate       DateTime
  leadTimeDays     Int                 @default(14)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  campaign  Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  proposals SessionProposal[]
}

enum DndBeyondSyncStatus {
  NOT_LINKED
  PENDING
  SUCCESS
  FAILED
  PRIVATE
}

model Character {
  id                    String              @id @default(cuid())
  campaignId            String
  memberId              String              @unique
  name                  String
  class                 String
  level                 Int
  race                  String?
  notes                 String?             @db.Text
  portraitUrl           String? // from D&D Beyond's avatarUrl on sync; no manual upload path
  dndBeyondUrl          String?
  dndBeyondCharacterId  String?
  dndBeyondSyncStatus   DndBeyondSyncStatus @default(NOT_LINKED)
  dndBeyondLastSyncedAt DateTime?
  dndBeyondSnapshot     Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member   CampaignMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

enum CampaignNoteType {
  GENERAL // legacy: moved to a DmPage by 20261124230000_add_dm_pages, no longer read
  NEXT_SESSION_PREP // legacy: moved to a DmPage (or a session's prep), no longer read
  PARTY
}

/// DM-only notes (GENERAL, NEXT_SESSION_PREP) and the shared party note
/// (PARTY, editable by any campaign member) — one row per type per
/// campaign. Distinct from PlayerNote, which is one-per-member-private
/// rather than campaign-wide, hence a separate model instead of a shared
/// unique key.
model CampaignNote {
  id         String           @id @default(cuid())
  campaignId String
  authorId   String
  type       CampaignNoteType
  content    String           @db.Text
  updatedAt  DateTime         @updatedAt
  createdAt  DateTime         @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@unique([campaignId, type])
}

/// A single private note per campaign member, visible only to them.
model PlayerNote {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  content    String   @db.Text
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

enum NotificationType {
  CAMPAIGN_INVITE
  MEMBER_JOINED
  MEMBER_LEFT
  SESSION_PROPOSED
  SESSION_CANCELLED
  RSVP_CHANGED
  RECURRING_DRAFT_READY
  SESSION_RESCHEDULED
  SESSION_CONFIRMED
  SESSION_REMINDER
  RECAP_POSTED
  SAFETY_TOOL_ADDED
  DATE_POLL_OPENED
  PAGE_REVEALED // the DM shared a page from their notebook with the party
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  campaignId  String?
  type        NotificationType
  title       String
  body        String?
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
}

enum SafetyKind {
  LINE // never appears in the game
  VEIL // can happen, but off-screen / fade to black
}

/// A line or veil. Anonymous by design: authorId is only used to let the
/// author remove their own entry and is never shown to anyone else.
model SafetyEntry {
  id         String     @id @default(cuid())
  campaignId String
  authorId   String?
  kind       SafetyKind
  text       String
  createdAt  DateTime   @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([campaignId])
}

/// An uploaded profile picture: a 256×256 WebP re-encoded on the server.
/// Kept out of the User row so the image bytes aren't loaded with every user.
model UserAvatar {
  userId    String   @id
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotebookKind {
  DM // the campaign DM's notebook (incl. session prep)
  PERSONAL // one player's private notebook (ownerId), hidden even from the DM
  PARTY // shared by everyone in the campaign
}

/// A notebook page. `kind` (and `ownerId` for personal notebooks) decides
/// which notebook it's in; every query filters on both, so pages from
/// another notebook can't be reached. Kept in its own table (still called
/// "DmPage", from when only the DM had one) so it's never loaded along with
/// data other people receive.
model NotebookPage {
  id                String       @id @default(cuid())
  campaignId        String
  kind              NotebookKind @default(DM)
  ownerId           String? // PERSONAL only: whose notebook
  createdById       String? // who made the page; in the party notebook only they (or the DM) may delete it
  title             String
  content           String       @default("") @db.Text
  pinned            Boolean      @default(false)
  sessionProposalId String?      @unique // DM notebook only: that session's prep
  revealedFromId    String?      @unique // PARTY only: the DM page this was revealed from ("Reveal to party")
  revealedAt        DateTime? // when the DM last revealed (or re-revealed) it
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt // also the optimistic-concurrency version for edits

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner           User?            @relation("NotebookPages", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("NotebookPagesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  sessionProposal SessionProposal? @relation(fields: [sessionProposalId], references: [id], onDelete: SetNull)
  revealedFrom    NotebookPage?    @relation("Reveal", fields: [revealedFromId], references: [id], onDelete: SetNull)
  revealedAs      NotebookPage?    @relation("Reveal")

  @@index([campaignId, updatedAt])
  @@index([campaignId, kind, ownerId])
  @@map("DmPage")
}

/// Days someone can't play (a holiday, exams). Belongs to the person, not a
/// campaign, so every campaign they're in sees it. The days are calendar
/// dates in the group's timezone (the server's TZ), like the reminders.
model AwayPeriod {
  id        String   @id @default(cuid())
  userId    String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date // inclusive
  note      String? // optional short reason, shown to the people they play with
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsOn])
}

/// A Discord message the bot posted about a session, with RSVP buttons. Kept
/// so the RSVP counts on it can be updated when anyone answers (on the site
/// or in Discord), and the buttons removed if the session is cancelled.
model DiscordSessionMessage {
  id                String   @id @default(cuid())
  sessionProposalId String
  channelId         String
  messageId         String
  embed             Json // the post's own embed, before the RSVP fields are added
  createdAt         DateTime @default(now())

  sessionProposal SessionProposal @relation(fields: [sessionProposalId], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
  @@index([sessionProposalId])
}

/// A Discord message the bot posted about a date poll, with a Vote button.
/// Kept so the counts on it can be updated as people vote (on the site or in
/// Discord), and the button removed once a date is picked.
model DiscordPollMessage {
  id        String   @id @default(cuid())
  pollId    String
  channelId String
  messageId String
  embed     Json // what was announced ("Which date works for you?"), for redrawing the post
  createdAt DateTime @default(now())

  poll DatePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
  @@index([pollId])
}

/// A picture in a notebook (a map, a handout, an NPC portrait). It belongs
/// to a notebook the same way pages do: the DM's notebook (DM only), one
/// player's private notebook (ownerId; only them), or the party notebook
/// (everyone in the campaign). Re-encoded on upload as WebP, no bigger than
/// 2400px, with metadata such as phone GPS location removed.
model NotebookImage {
  id           String       @id @default(cuid())
  campaignId   String
  kind         NotebookKind
  ownerId      String? // PERSONAL only: whose notebook
  uploadedById String?
  data         Bytes
  width        Int
  height       Int
  size         Int // bytes stored, so totals don't need to read the images
  createdAt    DateTime     @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner      User?    @relation("NotebookImages", fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("NotebookImagesUploaded", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([campaignId, kind, ownerId])
}
