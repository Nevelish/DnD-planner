generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js required models ----------

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for Discord-only accounts
  calendarToken String?   @unique // secret token for the .ics subscription feed
  role          UserRole  @default(USER)

  accounts Account[]
  sessions Session[]

  memberships      CampaignMember[]
  proposedSessions SessionProposal[]  @relation("ProposedBy")
  notifications    Notification[]
  campaignNotes    CampaignNote[]
  ownedCampaigns   Campaign[]         @relation("CampaignOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Single-row table of server-wide settings, managed from /admin/settings.
/// Always read/written at the fixed id "default" — there is only ever one row.
model AppSettings {
  id        String   @id @default("default")
  publicUrl String? // overrides NEXTAUTH_URL for building absolute links (invites, calendar feed)
  updatedAt DateTime @updatedAt
}

// ---------- Core domain ----------

enum CampaignRole {
  DM
  PLAYER
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  ownerId     String
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner            User              @relation("CampaignOwner", fields: [ownerId], references: [id])
  members          CampaignMember[]
  sessionProposals SessionProposal[]
  recurringRules   RecurringRule[]
  characters       Character[]
  notes            CampaignNote[]
  notifications    Notification[]
}

model CampaignMember {
  id         String       @id @default(cuid())
  campaignId String
  userId     String
  role       CampaignRole
  joinedAt   DateTime     @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  rsvps      Rsvp[]
  characters Character[]

  @@unique([campaignId, userId])
}

enum SessionProposalStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model SessionProposal {
  id              String                 @id @default(cuid())
  campaignId      String
  proposedById    String
  title           String?
  startsAt        DateTime
  durationMinutes Int?
  status          SessionProposalStatus  @default(PROPOSED)
  recurringRuleId String?
  cancelReason    String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  proposedBy    User           @relation("ProposedBy", fields: [proposedById], references: [id])
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id])
  rsvps         Rsvp[]

  @@index([campaignId, startsAt])
}

enum RsvpStatus {
  PENDING
  YES
  NO
}

model Rsvp {
  id                 String     @id @default(cuid())
  sessionProposalId  String
  memberId           String
  status             RsvpStatus @default(PENDING)
  cancellationReason String?    @db.Text
  respondedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessionProposal SessionProposal @relation(fields: [sessionProposalId], references: [id], onDelete: Cascade)
  member          CampaignMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionProposalId, memberId])
}

enum RecurrenceFrequency {
  WEEKLY
  CUSTOM_INTERVAL
}

model RecurringRule {
  id               String              @id @default(cuid())
  campaignId       String
  frequency        RecurrenceFrequency
  intervalWeeks    Int                 @default(1)
  dayOfWeek        Int
  timeOfDayMinutes Int
  timezone         String
  anchorDate       DateTime
  leadTimeDays     Int                 @default(14)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  campaign  Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  proposals SessionProposal[]
}

enum DndBeyondSyncStatus {
  NOT_LINKED
  PENDING
  SUCCESS
  FAILED
  PRIVATE
}

model Character {
  id                    String              @id @default(cuid())
  campaignId            String
  memberId              String              @unique
  name                  String
  class                 String
  level                 Int
  race                  String?
  notes                 String?             @db.Text
  dndBeyondUrl          String?
  dndBeyondCharacterId  String?
  dndBeyondSyncStatus   DndBeyondSyncStatus @default(NOT_LINKED)
  dndBeyondLastSyncedAt DateTime?
  dndBeyondSnapshot     Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member   CampaignMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

enum CampaignNoteType {
  GENERAL
  NEXT_SESSION_PREP
}

model CampaignNote {
  id         String           @id @default(cuid())
  campaignId String
  authorId   String
  type       CampaignNoteType
  content    String           @db.Text
  updatedAt  DateTime         @updatedAt
  createdAt  DateTime         @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@unique([campaignId, type])
}

enum NotificationType {
  CAMPAIGN_INVITE
  MEMBER_JOINED
  MEMBER_LEFT
  SESSION_PROPOSED
  SESSION_CANCELLED
  RSVP_CHANGED
  RECURRING_DRAFT_READY
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  campaignId  String?
  type        NotificationType
  title       String
  body        String?
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
}
